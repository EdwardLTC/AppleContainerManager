<idea-plugin>
    <id>dev.containermanager.applecontainer</id>
    <name>Apple Container Manager</name>
    <vendor url="https://github.com/EdwardLTC/AppleContainerManager">Edward</vendor>

    <description><![CDATA[
        <p>A native IntelliJ IDEA experience for managing <a href="https://github.com/apple/container">Apple's <code>container</code></a> runtime
        not a generic Docker UI. Manage containers, images, volumes, networks, and the container
        system daemon from a dedicated tool window, launch containers with first-class Run
        Configurations, stream logs and exec sessions into the Run tool window, and jump to
        anything from Search Everywhere.</p>
        <ul>
            <li>Containers: run, start, stop, kill, delete, logs, exec, inspect, live stats</li>
            <li>Images: pull, push, build (with Dockerfile gutter integration), tag, delete, prune</li>
            <li>Volumes &amp; Networks: create, inspect, delete, prune</li>
            <li>System: start/stop services, version, disk usage, builder lifecycle</li>
            <li>Run Configurations for launching containers like any other IDE run target</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Services view: replaces the standalone Tool Window -->
        <serviceViewContributor
                implementation="dev.containermanager.applecontainer.services.view.AppleContainerServiceViewContributor"/>

        <!-- Notifications -->
        <notificationGroup id="Apple Container Manager" displayType="BALLOON"/>

        <!-- Settings -->
        <applicationConfigurable
                parentId="tools"
                instance="dev.containermanager.applecontainer.settings.AppleContainerSettingsConfigurable"
                id="dev.containermanager.applecontainer.settings"
                displayName="Apple Container Manager"/>

        <!-- Startup check -->
        <postStartupActivity
                implementation="dev.containermanager.applecontainer.listeners.AppleContainerStartupActivity"/>

        <!-- Run Configuration -->
        <configurationType implementation="dev.containermanager.applecontainer.run.ContainerRunConfigurationType"/>

        <runLineMarkerContributor
                implementationClass="dev.containermanager.applecontainer.run.DockerfileRunLineMarkerContributor"
                language=""/>

        <runLineMarkerContributor
                implementationClass="dev.containermanager.applecontainer.run.ComposeFileRunLineMarkerContributor"
                language=""/>
    </extensions>

    <actions>
        <!-- ============================= Compose actions ================================ -->
        <action id="AppleContainerManager.ComposeUp"
                class="dev.containermanager.applecontainer.actions.compose.ComposeUpAction"
                text="Apple Container: Up" description="Build and start every service in this Compose file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="AppleContainerManager.ComposeDown"
                class="dev.containermanager.applecontainer.actions.compose.ComposeDownAction"
                text="Apple Container: Down" description="Stop and remove every service in this Compose file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after"
                          relative-to-action="AppleContainerManager.ComposeUp"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="AppleContainerManager.ComposeUp"/>
        </action>
    </actions>
</idea-plugin>
