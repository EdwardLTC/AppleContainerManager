<idea-plugin>
    <id>dev.containermanager.applecontainer</id>
    <name>Apple Container Manager</name>
    <vendor url="https://github.com/EdwardLTC/AppleContainerManager">Edward</vendor>

    <description><![CDATA[
        <p>A native IntelliJ IDEA experience for managing <a href="https://github.com/apple/container">Apple's <code>container</code></a> runtime
        not a generic Docker UI. Manage containers, images, volumes, networks, and the container
        system daemon from a dedicated tool window, launch containers with first-class Run
        Configurations, stream logs and exec sessions into the Run tool window, and jump to
        anything from Search Everywhere.</p>
        <ul>
            <li>Containers: run, start, stop, kill, delete, logs, exec, inspect, live stats</li>
            <li>Images: pull, push, build (with Dockerfile gutter integration), tag, delete, prune</li>
            <li>Volumes &amp; Networks: create, inspect, delete, prune</li>
            <li>System: start/stop services, version, disk usage, builder lifecycle</li>
            <li>Run Configurations for launching containers like any other IDE run target</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Services view: replaces the standalone Tool Window -->
        <serviceViewContributor
                implementation="dev.containermanager.applecontainer.services.view.AppleContainerServiceViewContributor"/>

        <!-- Notifications -->
        <notificationGroup id="Apple Container Manager" displayType="BALLOON"/>

        <!-- Settings -->
        <applicationConfigurable
                parentId="tools"
                instance="dev.containermanager.applecontainer.settings.AppleContainerSettingsConfigurable"
                id="dev.containermanager.applecontainer.settings"
                displayName="Apple Container Manager"/>

        <!-- Startup check -->
        <postStartupActivity
                implementation="dev.containermanager.applecontainer.listeners.AppleContainerStartupActivity"/>

        <!-- Run Configuration -->
        <configurationType implementation="dev.containermanager.applecontainer.run.ContainerRunConfigurationType"/>

        <runLineMarkerContributor
                implementationClass="dev.containermanager.applecontainer.run.DockerfileRunLineMarkerContributor"
                language=""/>

        <runLineMarkerContributor
                implementationClass="dev.containermanager.applecontainer.run.ComposeFileRunLineMarkerContributor"
                language=""/>

        <!-- Search Everywhere -->
        <searchEverywhereContributor
                implementation="dev.containermanager.applecontainer.search.ContainerSearchEverywhereContributor$Factory"/>
    </extensions>

    <actions>
        <!-- ============================ Container actions ============================ -->
        <action id="AppleContainerManager.Refresh"
                class="dev.containermanager.applecontainer.actions.container.RefreshContainersAction"
                text="Refresh" description="Refresh the container list"
                icon="AllIcons.Actions.Refresh"/>
        <action id="AppleContainerManager.ToggleContainer"
                class="dev.containermanager.applecontainer.actions.container.ToggleContainerAction"
                text="Start" description="Start the selected container(s)"
                icon="AllIcons.Actions.Execute"/>
        <action id="AppleContainerManager.KillContainer"
                class="dev.containermanager.applecontainer.actions.container.KillContainerAction"
                text="Kill" description="Kill the selected container(s)"
                icon="AllIcons.Process.Stop"/>
        <action id="AppleContainerManager.DeleteContainer"
                class="dev.containermanager.applecontainer.actions.container.DeleteContainerAction"
                text="Delete" description="Delete the selected container(s)"
                icon="AllIcons.Actions.GC"/>
        <action id="AppleContainerManager.PruneContainers"
                class="dev.containermanager.applecontainer.actions.container.PruneContainersAction"
                text="Prune" description="Prune unused containers"
                icon="AllIcons.Actions.ClearCash"/>
        <action id="AppleContainerManager.ViewLogs"
                class="dev.containermanager.applecontainer.actions.container.ViewLogsAction"
                text="View Logs" description="View logs for the selected container(s)"
                icon="AllIcons.Actions.ShowAsTree"/>
        <action id="AppleContainerManager.ExecInContainer"
                class="dev.containermanager.applecontainer.actions.container.ExecInContainerAction"
                text="Exec Shell…" description="Execute a command in the selected container(s)"
                icon="AllIcons.Debugger.Console"/>
        <action id="AppleContainerManager.ViewStats"
                class="dev.containermanager.applecontainer.actions.container.ViewStatsAction"
                text="View Live Stats" description="Stream CPU / memory / network stats"
                icon="AllIcons.Actions.Profile"/>
        <action id="AppleContainerManager.InspectContainer"
                class="dev.containermanager.applecontainer.actions.container.InspectContainerAction"
                text="Inspect" description="Inspect the selected container"
                icon="AllIcons.Actions.Preview"/>

        <!-- ============================== Image actions =============================== -->
        <action id="AppleContainerManager.PullImage"
                class="dev.containermanager.applecontainer.actions.image.PullImageAction"
                text="Pull Image…" description="Pull an image by reference"
                icon="AllIcons.Actions.Download"/>
        <action id="AppleContainerManager.BuildImage"
                class="dev.containermanager.applecontainer.actions.image.BuildImageAction"
                text="Build Image" description="Build an image from a Dockerfile"
                icon="AllIcons.Actions.Compile"/>
        <action id="AppleContainerManager.RunImage"
                class="dev.containermanager.applecontainer.actions.image.RunImageAction"
                text="Run Image" description="Run a container from the selected image"
                icon="AllIcons.Actions.Execute"/>
        <action id="AppleContainerManager.PushImage"
                class="dev.containermanager.applecontainer.actions.image.PushImageAction"
                text="Push Image" description="Push the selected image to its registry"
                icon="AllIcons.Actions.Upload"/>
        <action id="AppleContainerManager.TagImage"
                class="dev.containermanager.applecontainer.actions.image.TagImageAction"/>
        <action id="AppleContainerManager.DeleteImage"
                class="dev.containermanager.applecontainer.actions.image.DeleteImageAction"
                text="Delete" description="Delete the selected image(s)"
                icon="AllIcons.Actions.GC"/>
        <action id="AppleContainerManager.PruneImages"
                class="dev.containermanager.applecontainer.actions.image.PruneImagesAction"
                text="Prune Unused Images" description="Remove dangling / unused images"
                icon="AllIcons.Actions.ClearCash"/>
        <action id="AppleContainerManager.InspectImage"
                class="dev.containermanager.applecontainer.actions.image.InspectImageAction"
                text="Inspect" description="Show full image metadata as JSON"
                icon="AllIcons.Actions.Preview"/>

        <!-- ============================= Volume actions ================================ -->
        <action id="AppleContainerManager.CreateVolume"
                class="dev.containermanager.applecontainer.actions.volume.CreateVolumeAction"
                text="Create Volume" description="Create a new named volume"
                icon="AllIcons.General.Add"/>
        <action id="AppleContainerManager.DeleteVolume"
                class="dev.containermanager.applecontainer.actions.volume.DeleteVolumeAction"
                text="Delete" description="Delete the selected volume(s)"
                icon="AllIcons.Actions.GC"/>
        <action id="AppleContainerManager.PruneVolumes"
                class="dev.containermanager.applecontainer.actions.volume.PruneVolumesAction"
                text="Prune Unused Volumes" description="Remove volumes not used by any container"
                icon="AllIcons.Actions.GC"/>
        <action id="AppleContainerManager.InspectVolume"
                class="dev.containermanager.applecontainer.actions.volume.InspectVolumeAction"
                text="Inspect" description="Show full volume metadata as JSON"
                icon="AllIcons.Actions.PreviewDetails"/>

        <!-- ============================ Network actions ================================ -->
        <action id="AppleContainerManager.CreateNetwork"
                class="dev.containermanager.applecontainer.actions.network.CreateNetworkAction"
                text="Create Network" description="Create a new network"
                icon="AllIcons.General.Add"/>
        <action id="AppleContainerManager.DeleteNetwork"
                class="dev.containermanager.applecontainer.actions.network.DeleteNetworkAction"
                text="Delete" description="Delete the selected network(s)"
                icon="AllIcons.Actions.GC"/>
        <action id="AppleContainerManager.PruneNetworks"
                class="dev.containermanager.applecontainer.actions.network.PruneNetworksAction"
                text="Prune Unused Networks" description="Remove networks not used by any container"
                icon="AllIcons.Actions.GC"/>
        <action id="AppleContainerManager.InspectNetwork"
                class="dev.containermanager.applecontainer.actions.network.InspectNetworkAction"
                text="Inspect" description="Show full network metadata as JSON"
                icon="AllIcons.Actions.PreviewDetails"/>

        <!-- ============================= Compose actions ================================ -->
        <action id="AppleContainerManager.ComposeUp"
                class="dev.containermanager.applecontainer.actions.compose.ComposeUpAction"
                text="Apple Container: Up" description="Build and start every service in this Compose file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action id="AppleContainerManager.ComposeDown"
                class="dev.containermanager.applecontainer.actions.compose.ComposeDownAction"
                text="Apple Container: Down" description="Stop and remove every service in this Compose file">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after"
                          relative-to-action="AppleContainerManager.ComposeUp"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="AppleContainerManager.ComposeUp"/>
        </action>

        <!-- ================================ Toolbars ==================================== -->
        <group id="AppleContainerManager.ContainersToolbar">
            <reference ref="AppleContainerManager.Refresh"/>
            <separator/>
            <reference ref="AppleContainerManager.ToggleContainer"/>
            <reference ref="AppleContainerManager.KillContainer"/>
            <reference ref="AppleContainerManager.DeleteContainer"/>
            <separator/>
            <reference ref="AppleContainerManager.ViewLogs"/>
            <reference ref="AppleContainerManager.ExecInContainer"/>
            <reference ref="AppleContainerManager.ViewStats"/>
            <reference ref="AppleContainerManager.InspectContainer"/>
            <separator/>
            <reference ref="AppleContainerManager.PruneContainers"/>
        </group>

        <group id="AppleContainerManager.ImagesToolbar">
            <reference ref="AppleContainerManager.Refresh"/>
            <separator/>
            <reference ref="AppleContainerManager.PullImage"/>
            <reference ref="AppleContainerManager.BuildImage"/>
            <separator/>
            <reference ref="AppleContainerManager.RunImage"/>
            <reference ref="AppleContainerManager.PushImage"/>
            <reference ref="AppleContainerManager.TagImage"/>
            <reference ref="AppleContainerManager.DeleteImage"/>
            <separator/>
            <reference ref="AppleContainerManager.InspectImage"/>
            <reference ref="AppleContainerManager.PruneImages"/>
        </group>

        <group id="AppleContainerManager.VolumesToolbar">
            <reference ref="AppleContainerManager.Refresh"/>
            <separator/>
            <reference ref="AppleContainerManager.CreateVolume"/>
            <reference ref="AppleContainerManager.DeleteVolume"/>
            <separator/>
            <reference ref="AppleContainerManager.InspectVolume"/>
            <reference ref="AppleContainerManager.PruneVolumes"/>
        </group>

        <group id="AppleContainerManager.NetworksToolbar">
            <reference ref="AppleContainerManager.Refresh"/>
            <separator/>
            <reference ref="AppleContainerManager.CreateNetwork"/>
            <reference ref="AppleContainerManager.DeleteNetwork"/>
            <separator/>
            <reference ref="AppleContainerManager.InspectNetwork"/>
            <reference ref="AppleContainerManager.PruneNetworks"/>
        </group>
    </actions>
</idea-plugin>
